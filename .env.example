# Safe competition deployment defaults: use the labeled historical catalog and do not contact CelesTrak.
ORBITGUARD_OFFLINE_MODE="true"

# Optional UTC timestamp that temporarily suppresses CelesTrak requests after a provider refusal.
ORBITGUARD_CELESTRAK_REFUSAL_UNTIL=""

# Optional persistent directory for the provider cache and cooldown metadata.
# Use a mounted persistent disk path on hosts whose temporary directory is ephemeral.
ORBITGUARD_CACHE_DIR=""

# Optional: enables server-side Gemini wording in Explainable Analysis.
# SGP4 metrics remain computed by OrbitGuard; no key is needed for core features.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
# Use deterministic explanations without Gemini network calls in offline competition mode.
ORBITGUARD_DISABLE_GEMINI="true"
